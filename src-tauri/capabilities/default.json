{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "workspace-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "opener:default",
    "log:default",
    "dialog:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://schema.cloudformation.*.amazonaws.com/CloudformationSchema.zip"
        },
        {
          "url": "https://api.github.com/repos/*/*/branches/*"
        },
        {
          "url": "https://api.github.com/repos/*/*/zipball/*"
        }
      ]
    }
  ]
}
