{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default",
    "fs:default",
    "dialog:default",
    "http:default",
    "fs:allow-localdata-read-recursive",
