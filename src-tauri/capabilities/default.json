{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "workspace-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "log:default",
    "dialog:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://schema.cloudformation.*.amazonaws.com/CloudformationSchema.zip"
        },
        {
          "url": "https://raw.githubusercontent.com/AkasakiTomohiro/formation-docs/refs/heads/feature/version-check/version.json"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/AkasakiTomohiro/formation-docs/releases"
        }
      ]
    }
  ]
}
