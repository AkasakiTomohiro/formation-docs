{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "workspace-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "opener:default",
    "log:default",
    "dialog:default",
    "http:default",
    "dialog:allow-open"
  ]
}
