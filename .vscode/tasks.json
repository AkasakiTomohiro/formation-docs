{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust Coverage",
      "type": "shell",
      "command": "cargo",
      "args": ["+nightly", "coverage"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "problemMatcher": ["$rustc"],
      "group": "test"
    }
  ]
}
